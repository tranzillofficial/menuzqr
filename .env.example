# ---- Supabase ----
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> publishable / anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Project Settings -> API Keys -> service_role / secret key. SERVER ONLY. Never expose.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---- Google Gemini (AI menu assistance) ----
# https://aistudio.google.com/apikey  -- SERVER ONLY, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- App ----
# Public origin used when building QR code links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp support number in international format, digits only.
NEXT_PUBLIC_SUPPORT_WHATSAPP=201094963553

# ---- Local development only ----
# Testing the phone view over your Wi-Fi? Put this machine's LAN IP here and
# set NEXT_PUBLIC_SITE_URL to the same host, e.g. http://192.168.1.10:3000
# DEV_ALLOWED_ORIGINS=192.168.1.10
