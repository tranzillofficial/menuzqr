# ---- Supabase ----
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> publishable / anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Project Settings -> API Keys -> service_role / secret key. SERVER ONLY. Never expose.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---- Google Gemini (AI menu assistance) ----
# https://aistudio.google.com/apikey  -- SERVER ONLY, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Web push (notifications when the app is closed) ----
# These are a VAPID key pair. The public half is safe in the browser; the
# private half is server-only. Generate your own with:
#   npx web-push generate-vapid-keys
# Leave them empty and the app still works — it just cannot wake a phone
# whose screen is off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: or https: URL a push service can use to contact you.
VAPID_SUBJECT=mailto:support@menuzqr.com

# ---- App ----
# Public origin used when building QR code links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The support WhatsApp number is NOT set here — an admin edits it at
# /admin/platform so it can change without a redeploy.

# ---- Local development only ----
# Testing the phone view over your Wi-Fi? Put this machine's LAN IP here and
# set NEXT_PUBLIC_SITE_URL to the same host, e.g. http://192.168.1.10:3000
# DEV_ALLOWED_ORIGINS=192.168.1.10
